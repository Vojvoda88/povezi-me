{
  "name": "povezi-me",
  "version": "1.0.0",
  "description": "Poveži.ME Premium Marketplace",
  "main": "dist/index.js",
  "engines": {
    "node": ">=18"
  },
  "overrides": {
    "esbuild": "0.21.5"
  },
  "scripts": {
    "backend": "cross-env PORT=3001 ts-node-dev --respawn --transpile-only src/index.ts",
    "backend:3002": "cross-env PORT=3002 ts-node-dev --respawn --transpile-only src/index.ts",
    "frontend": "vite",
    "frontend:host": "vite --host",
    "predev": "kill-port 3001",
    "dev": "concurrently -n b,f -c blue,green \"npm run backend\" \"npx wait-on http://localhost:3001/health -t 30000 && npm run frontend\"",
    "dev:host": "concurrently -n b,f -c blue,green \"npm run backend\" \"npx wait-on http://localhost:3001/health -t 30000 && npm run frontend:host\"",
    "dev:cluster": "concurrently -n b1,b2,f -c blue,magenta,green \"npm run backend\" \"npm run backend:3002\" \"npm run frontend\"",
    "e2e:serve": "cross-env PORT=3001 TEST_MODE=true concurrently -k -n b,f -c blue,green \"npm run backend\" \"vite --port 5175 --strictPort\"",
    "build": "tsc -p tsconfig.build.json",
    "build:frontend": "vite build",
    "start": "node dist/index.js",
    "start:prod": "cross-env NODE_ENV=production node dist/index.js",
    "test": "vitest",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "node scripts/migrate-deploy.js",
    "migrate:deploy": "node scripts/migrate-deploy.js",
    "db:seed": "prisma db seed",
    "deploy:check": "node scripts/deploy-check.js",
    "deploy:jwt": "node scripts/generate-jwt-secret.js",
    "smoke-test": "node scripts/smoke-test.js",
    "ci": "npm test && npm run smoke-test && npm run build && npm run build:frontend",
    "e2e": "node scripts/e2e-prepare.js && playwright test",
    "e2e:headed": "node scripts/e2e-prepare.js && playwright test --headed",
    "prod:sanity": "node scripts/prod-sanity.js",
    "cleanup": "node scripts/cleanup-images.js",
    "import-ads": "ts-node scripts/import-ads.ts",
    "redis:check": "node scripts/redis-chat-check.js"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "@sentry/node": "^10.39.0",
    "@sentry/react": "^10.39.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@supabase/supabase-js": "^2.95.3",
    "bcrypt": "^5.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "file-type": "^21.3.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.460.0",
    "multer": "^2.0.2",
    "nodemailer": "^6.9.13",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0",
    "react-window": "^1.8.10",
    "resend": "^3.2.0",
    "sanitize-html": "^2.17.0",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "stripe": "^20.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^7.0.10",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/react-window": "^1.8.8",
    "@types/sanitize-html": "^2.16.0",
    "@types/supertest": "^6.0.2",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.0.1",
    "cross-env": "^10.1.0",
    "kill-port": "^2.0.1",
    "prisma": "^5.14.0",
    "supertest": "^7.0.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5",
    "vite": "^5.4.10",
    "vitest": "^3.0.0",
    "wait-on": "^8.0.1"
  },
  "prisma": {
    "seed": "npx ts-node prisma/seed.ts"
  }
}
