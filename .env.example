# =============================================================================
# Povezi.me – primjer env varijabli (kopiraj u .env, nikad ne commituj .env)
# Generiši JWT_SECRET: npm run deploy:jwt
# =============================================================================

# --- Backend (obavezno u produkciji) ---
NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/povezi"
JWT_SECRET="promijenite-u-jak-tajni-kljuc-min-32-znaka"

# CORS i domeni (u produkciji obavezno FRONTEND_URL)
# FRONTEND_URL: domen sa kojeg se servira frontend (za CORS)
# PUBLIC_SITE_URL: javni URL frontenda (koristi se u sitemap-u, canonical linkovima)
# API_PUBLIC_URL: javni URL backend API-ja (koristi se u robots.txt, prod:sanity itd.)
FRONTEND_URL="https://povezi.me"
PUBLIC_SITE_URL="https://povezi.me"
API_PUBLIC_URL="https://api.povezi.me"
BACKEND_URL="https://api.povezi.me"

# --- Supabase Storage (obavezno za upload slika) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# --- E-mail (obavezno za zaboravljenu lozinku) ---
# Resend: https://resend.com → API Keys
RESEND_API_KEY=
# Ili SMTP:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM="Povezi.me <notifikacije@povezi.me>"

# --- Stripe (obavezno za plaćanja / istaknute oglase) ---
STRIPE_SECRET_KEY=sk_live_xxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxx

# --- Google prijava (opciono) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- reCAPTCHA v3 (opciono) ---
RECAPTCHA_SECRET_KEY=

# --- Sentry (monitoring – opciono) ---
# SENTRY_DSN=           # backend
# VITE_SENTRY_DSN=      # frontend (postavi pri build-u)

# --- Redis (za multi-instance chat) ---
# REDIS_URL=redis://localhost:6379

# =============================================================================
# Frontend – postavi VITE_API_URL pri build-u (Vercel/Netlify env)
# =============================================================================
VITE_API_URL=http://localhost:3001/api
# VITE_SOCKET_URL=   # opciono: poseban URL za Socket.io (default = isti base kao API bez /api)
# VITE_DEBUG_CHAT=true   # uključi chat debug log u konzoli (connect, disconnect, reconnect_attempt)

# =============================================================================
# Backend chat debug
# =============================================================================
# DEBUG_CHAT=true   # log socket connect (userId, socket.id), emit newMessage
